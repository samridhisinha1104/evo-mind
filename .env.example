# ─────────────────────────────────────────────
# EvoMind — Environment Variables
# Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────
# Default: "auto" (tries Groq first, falls back to HuggingFace)
# Options: groq | huggingface | anthropic | auto
EVOMIND_PROVIDER=auto

# Groq — free tier, fastest. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# HuggingFace — free tier fallback. Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# Anthropic Claude — paid. Uncomment to use.
# EVOMIND_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ── Optional: override the model ──────────────
# EVOMIND_MODEL=llama-3.3-70b-versatile

# ── Production Security ────────────────────────
# Comma-separated list of allowed CORS origins.
# Leave unset to allow all (fine for personal/friends use).
# ALLOWED_ORIGINS=https://your-app.up.railway.app,https://your-custom-domain.com

# Optional password to restrict access. Anyone with the URL
# will be prompted for this password. Leave unset for open access.
# APP_PASSWORD=your-secret-password

# ── Optional Tuning ────────────────────────────
# EVOMIND_MAX_ITERATIONS=5
# EVOMIND_SCORE_THRESHOLD=0.8
# EVOMIND_MAX_DATASET_MB=500
